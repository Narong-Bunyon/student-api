APP_NAME="Student API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

# Database Configuration
FORWARD_DB_PORT=3306
DB_CONNECTION=mysql
